# Copy to server/.env (never commit). Names only — fill locally.
# Do not paste values into chat.

# Places nearby (SerpAPI google_maps). Real shops + phones. No Google Places key.
SERPAPI_API_KEY=

# Twilio. Product path: TWILIO_FROM → Place phone. Trial only reaches verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_DEMO_TO=
TWILIO_WEBHOOK_BASE=

# Supabase (tasks / agents / transcript_lines). Service role only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# General Compute (planner / extract / synthesis). Either GC key name works.
GENERAL_COMPUTE_API_KEY=
GENERALCOMPUTE_API_KEY=
GENERAL_COMPUTE_BASE_URL=
GENERAL_COMPUTE_MODEL=gpt-oss-120b   # one-shot default; overrides: PLANNER_MODEL, EXTRACT_MODEL, DECISION_MODEL, CALL_LLM_MODEL

# Gradium (STT / TTS on calls).
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=4SZHfMpw-p46Ywgs   # Harper (US). Others: Garrett POBHtemksfWQbng0, Brooklyn D6COLz20Hw7uh3UK
# Per-language voices (Gradium flagship defaults in server/lang.py: Ximena es, Solène fr, Resi de, Rafaela pt).
GRADIUM_VOICE_ID_ES=
GRADIUM_VOICE_ID_FR=
GRADIUM_VOICE_ID_DE=
GRADIUM_VOICE_ID_PT=
# STT grounding: planner language by default; set to "any" to let Gradium detect the language.
GRADIUM_STT_LANGUAGE=
